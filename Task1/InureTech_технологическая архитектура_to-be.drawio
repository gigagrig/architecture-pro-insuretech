          </mxGeometry>
        </mxCell>
        <mxCell id="egress-b-label" value="egress B" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#385a8a;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1625" y="1306" width="300" height="22" />

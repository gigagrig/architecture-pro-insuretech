        <mxCell id="db-rw-label" value="primary" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#385a8a;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="130" y="925" width="300" height="22" />
        </mxCell>
        <mxCell id="sync" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#208354;fontColor=#208354;fontSize=14;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.375;exitPerimeter=0;entryX=0.0;entryY=0.375;entryPerimeter=0;" edge="1" parent="1" source="pg-a" target="pg-b">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="sync-label" value="SYNC" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#208354;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">

        </mxCell>
        <mxCell id="async-local" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#208354;fontColor=#208354;fontSize=14;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=1.0;entryPerimeter=0;" edge="1" parent="1" source="pg-a" target="pg-d">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="235" y="1135" />
              <mxPoint x="955" y="1135" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="async-local-label" value="WAL streaming • третья копия" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#208354;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="455" y="1124" width="300" height="22" />
        </mxCell>
        <mxCell id="pg-dr" value="&lt;b&gt;3 VM • PostgreSQL + Patroni standby cluster&lt;/b&gt;&lt;br&gt;standby leader → 2 cascade replicas (B1 / B2 / B3)&lt;br&gt;После promote: primary + sync + async&lt;br&gt;Отдельный etcd / DCS: 3 узла, quorum 2/3&lt;br&gt;H6: durable WAL watermark; RPO-контроль&lt;br&gt;Приём WAL по TLS: два независимых канала" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff7777;fontColor=#172c4c;fontFamily=Arial;fontSize=15;align=left;verticalAlign=top;spacing=14;spacingRight=55;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1260" y="960" width="570" height="175" />
        </mxCell>
        <mxCell id="pg-dr-icon" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="pg-dr">
          <mxGeometry as="geometry" x="525" y="12" width="30" height="30" />
        </mxCell>
        <mxCell id="db-b" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#385a8a;fontColor=#385a8a;fontSize=14;labelBackgroundColor=#ffffff;exitX=0.8070175438596491;exitY=1.0;exitPerimeter=0;entryX=0.8070175438596491;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="proxy-b" target="pg-dr">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="db-b-label" value="после promote" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#385a8a;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1570" y="924" width="300" height="22" />
        </mxCell>
        <mxCell id="wal-dr" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#208354;fontColor=#208354;fontSize=14;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.47368421052631576;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="pg-a" target="pg-dr">
          <mxGeometry as="geometry" relative="1">
            <Array>
              <mxPoint x="235" y="1155" />
              <mxPoint x="1190" y="1155" />
              <mxPoint x="1190" y="940" />
              <mxPoint x="1530" y="940" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="wal-dr-label" value="A primary → B • ASYNC WAL" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#208354;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1220" y="929" width="300" height="22" />
        </mxCell>
        <mxCell id="dcs-a" value="&lt;b&gt;Patroni DCS: etcd × 3 на отдельных VM, по одному на AZ&lt;/b&gt;&lt;br&gt;H7: quorum 2/3; leader lease + watchdog; роли выше — пример текущего состояния" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f8ff;strokeColor=#5282ff;fontColor=#172c4c;fontFamily=Arial;fontSize=15;align=left;verticalAlign=top;spacing=14;spacingRight=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="1180" width="1050" height="75" />
        </mxCell>
        <mxCell id="guard" value="&lt;b&gt;Предохранитель RPO • см. страницу 3&lt;/b&gt;&lt;br&gt;Lag &amp;gt; 5 мин → тревога; &amp;gt; 10 мин → стоп записи&lt;br&gt;Lease записи истекает ≤ 60 с при сбое контроля" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff6dc;strokeColor=#d6a239;fontColor=#172c4c;fontFamily=Arial;fontSize=15;align=left;verticalAlign=top;spacing=14;spacingRight=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1260" y="1170" width="570" height="85" />
        </mxCell>
        <mxCell id="backup" value="&lt;b&gt;pgBackRest → независимое Object Storage в РФ&lt;/b&gt;&lt;br&gt;Full еженедельно + diff ежедневно + WAL непрерывно&lt;br&gt;archive_timeout = 60 s; хранение ≥ 35 дней + WAL&lt;br&gt;Шифрование, отдельные права, неизменяемые копии&lt;br&gt;H8: непрерывность WAL и свежесть backup; PITR-тесты&lt;br&gt;Backup и WAL от A; после promote — от B в новый репозиторий" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff7777;fontColor=#172c4c;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=14;spacingRight=55;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="1340" width="700" height="185" />
        </mxCell>
        <mxCell id="backup-icon" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="backup">
          <mxGeometry as="geometry" x="655" y="12" width="30" height="30" />
        </mxCell>
        <mxCell id="backup-flow" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#208354;fontColor=#208354;fontSize=14;labelBackgroundColor=#ffffff;exitX=0.0;exitY=0.5;exitPerimeter=0;entryX=0.3;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="pg-a" target="backup">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="48" y="1020" />
              <mxPoint x="48" y="1310" />
              <mxPoint x="240" y="1310" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="backup-flow-label" value="PG → backup + WAL" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#208354;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="130" y="1299" width="300" height="22" />
        </mxCell>
        <mxCell id="origins" value="&lt;b&gt;Object Storage A + B • CDN origins&lt;/b&gt;&lt;br&gt;Версионированные web-артефакты в обеих площадках&lt;br&gt;H9: HEAD контрольного объекта; origin failover&lt;br&gt;Публикация версии после проверки обеих копий&lt;br&gt;CDN обслуживает географию; AZ обеспечивают HA&lt;br&gt;Персональные ответы через API без CDN-кеша" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff7777;fontColor=#172c4c;fontFamily=Arial;fontSize=15;align=left;verticalAlign=top;spacing=14;spacingRight=55;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="790" y="1340" width="500" height="185" />
        </mxCell>
        <mxCell id="origins-icon" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="origins">
          <mxGeometry as="geometry" x="455" y="12" width="30" height="30" />
        </mxCell>
        <mxCell id="external" value="&lt;b&gt;Внешние API и границы решения&lt;/b&gt;&lt;br&gt;Из обоих кластеров: egress/NAT ≥ 2 на площадку&lt;br&gt;Страховые компании: 5 сейчас, 10 в перспективе&lt;br&gt;Платёжный сервис; TLS, timeout, bounded retry&lt;br&gt;Изменение интеграций — Task3 / Task4&lt;br&gt;Иконки YC обозначают типы ресурсов, в т. ч. self-hosted" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff7777;fontColor=#172c4c;fontFamily=Arial;fontSize=15;align=left;verticalAlign=top;spacing=14;spacingRight=55;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1350" y="1340" width="520" height="185" />
        </mxCell>
        <mxCell id="external-icon" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="external">
          <mxGeometry as="geometry" x="475" y="12" width="30" height="30" />
        </mxCell>
        <mxCell id="cdn-origin" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#d2841e;fontColor=#d2841e;fontSize=14;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.5;entryY=1.0;entryPerimeter=0;" edge="1" parent="1" source="cdn" target="origins">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1885" y="180" />
              <mxPoint x="1885" y="1550" />
              <mxPoint x="1040" y="1550" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="cdn-origin-label" value="HTTPS • origin fetch + H9" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#d2841e;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1270" y="1539" width="300" height="22" />
        </mxCell>
        <mxCell id="egress-a" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#385a8a;fontColor=#385a8a;fontSize=14;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.9655172413793104;exitPerimeter=0;entryX=0.46153846153846156;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="k8s-a" target="external">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1180" y="780" />
              <mxPoint x="1180" y="1300" />
              <mxPoint x="1590" y="1300" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="egress-a-label" value="HTTPS • egress A" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#385a8a;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1340" y="1289" width="300" height="22" />
        </mxCell>
        <mxCell id="egress-b" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#385a8a;fontColor=#385a8a;fontSize=14;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.7931034482758621;exitPerimeter=0;entryX=0.9615384615384616;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="k8s-b" target="external">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1850" y="730" />

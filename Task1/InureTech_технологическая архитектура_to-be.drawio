      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-2" name="02 — Масштабирование и health checks">
    <mxGraphModel dx="1900" dy="1450" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Масштабирование • маршрутизация • контроль здоровья&lt;/b&gt;&lt;br&gt;Применяется к обеим площадкам; B принимает пользовательский трафик только после разрешённого failover" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e3ebff;strokeColor=#5282ff;fontColor=#172c4c;fontFamily=Arial;fontSize=22;align=left;verticalAlign=top;spacing=14;spacingRight=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1840" height="80" />
        </mxCell>
        <mxCell id="why" value="&lt;b&gt;Почему два независимых Kubernetes-кластера&lt;/b&gt;&lt;br&gt;Внутри площадки кластер растянут на 3 близкие AZ: низкий RTT, quorum 2/3.&lt;br&gt;Между регионами control-plane / etcd не растягиваются: WAN не влияет на quorum.&lt;br&gt;Отдельные обновления, учётные записи и контуры управления ограничивают общий отказ.&lt;br&gt;GitOps доставляет одинаковые версии; образы и секреты доступны локально в B.&lt;br&gt;Во всех AZ есть готовые pods; нет привязки пользовательской сессии к pod.&lt;br&gt;БД вынесена на VM; состояние приложения и идемпотентность сохраняются в PostgreSQL." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e3ebff;strokeColor=#5282ff;fontColor=#172c4c;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=14;spacingRight=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="135" width="890" height="225" />
        </mxCell>
        <mxCell id="scale" value="&lt;b&gt;Стратегия мощности и развёртывания&lt;/b&gt;&lt;br&gt;Горизонтально: HPA по CPU / памяти, затем RPS через Prometheus Adapter; node autoscaler.&lt;br&gt;minReplicas = 3 на сервис, распределение по zone и hostname, PDB minAvailable = 2.&lt;br&gt;requests/limits и maxReplicas определяются нагрузочным тестом; rolling update без простоя.&lt;br&gt;Каждая из 3 AZ рассчитана минимум на 50% проектного пика: потеря AZ не ждёт HPA.&lt;br&gt;B заранее имеет мощность на 100% пика; пулы соединений ограничивают нагрузку на БД.&lt;br&gt;Вертикально: CPU/RAM/IOPS PostgreSQL по измерениям; обновление через replica + switchover." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef8f0;strokeColor=#64a978;fontColor=#172c4c;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=14;spacingRight=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="970" y="135" width="900" height="225" />
        </mxCell>
        <mxCell id="edge" value="&lt;b&gt;Глобальный edge LB&lt;/b&gt;&lt;br&gt;H1 • HTTPS /ready-origin&lt;br&gt;API не кешируется; retry с ограничениями" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff7777;fontColor=#172c4c;fontFamily=Arial;fontSize=15;align=left;verticalAlign=top;spacing=14;spacingRight=55;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="410" width="380" height="110" />
        </mxCell>
        <mxCell id="edge-icon" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="edge">
          <mxGeometry as="geometry" x="335" y="12" width="30" height="30" />
        </mxCell>
        <mxCell id="ingress" value="&lt;b&gt;Региональный LB → Ingress&lt;/b&gt;&lt;br&gt;H2 • GET /ingress-ready&lt;br&gt;Маршруты core-app и client-info" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff7777;fontColor=#172c4c;fontFamily=Arial;fontSize=15;align=left;verticalAlign=top;spacing=14;spacingRight=55;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="530" y="410" width="380" height="110" />
        </mxCell>
        <mxCell id="ingress-icon" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="ingress">
          <mxGeometry as="geometry" x="335" y="12" width="30" height="30" />
        </mxCell>
        <mxCell id="pods" value="&lt;b&gt;Kubernetes Services → pods&lt;/b&gt;&lt;br&gt;H3 • readiness /readyz&lt;br&gt;Только Ready endpoints в балансировке" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff7777;fontColor=#172c4c;fontFamily=Arial;fontSize=15;align=left;verticalAlign=top;spacing=14;spacingRight=55;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1030" y="410" width="400" height="110" />
        </mxCell>
        <mxCell id="pods-icon" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="pods">
          <mxGeometry as="geometry" x="355" y="12" width="30" height="30" />
        </mxCell>
        <mxCell id="db" value="&lt;b&gt;DB proxy → primary&lt;/b&gt;&lt;br&gt;H5 • GET :8008/primary&lt;br&gt;H7 • DCS quorum / lease" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff7777;fontColor=#172c4c;fontFamily=Arial;fontSize=15;align=left;verticalAlign=top;spacing=14;spacingRight=55;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1530" y="410" width="340" height="110" />
        </mxCell>
        <mxCell id="db-icon" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="db">
          <mxGeometry as="geometry" x="295" y="12" width="30" height="30" />
        </mxCell>
        <mxCell id="h1" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#d2841e;fontColor=#d2841e;fontSize=14;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=1.0;exitY=0.45454545454545453;exitPerimeter=0;entryX=0.0;entryY=0.45454545454545453;entryPerimeter=0;" edge="1" parent="1" source="edge" target="ingress">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="h1-label" value="H1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#d2841e;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="320" y="428" width="300" height="22" />
        </mxCell>
        <mxCell id="h2" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#d2841e;fontColor=#d2841e;fontSize=14;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=1.0;exitY=0.45454545454545453;exitPerimeter=0;entryX=0.0;entryY=0.45454545454545453;entryPerimeter=0;" edge="1" parent="1" source="ingress" target="pods">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="h2-label" value="H2" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#d2841e;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="820" y="428" width="300" height="22" />
        </mxCell>
        <mxCell id="h5" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#d2841e;fontColor=#d2841e;fontSize=14;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=1.0;exitY=0.45454545454545453;exitPerimeter=0;entryX=0.0;entryY=0.45454545454545453;entryPerimeter=0;" edge="1" parent="1" source="pods" target="db">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="h5-label" value="SQL + H5" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#d2841e;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1330" y="428" width="300" height="22" />
        </mxCell>
        <mxCell id="kubelet" value="&lt;b&gt;Kubelet → каждый контейнер&lt;/b&gt;&lt;br&gt;H4 • /livez; startupProbe /startupz&lt;br&gt;Liveness не зависит от БД / страховщиков" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff7777;fontColor=#172c4c;fontFamily=Arial;fontSize=15;align=left;verticalAlign=top;spacing=14;spacingRight=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1030" y="575" width="400" height="95" />
        </mxCell>
        <mxCell id="h4" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#d2841e;fontColor=#d2841e;fontSize=14;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0.4875;exitY=0.0;exitPerimeter=0;entryX=0.4875;entryY=1.0;entryPerimeter=0;" edge="1" parent="1" source="kubelet" target="pods">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="h4-label" value="H3 / H4" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#d2841e;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1160" y="536" width="300" height="22" />
        </mxCell>
        <mxCell id="monitor" value="&lt;b&gt;Prometheus + Alertmanager × 2; внешние синтетические проверки&lt;/b&gt;&lt;br&gt;Сбор в A и B; дежурный 24/7; независимый от A канал оповещений&lt;br&gt;H6 / H7 / H8 / H9 + H10: клиентские сценарии из нескольких регионов РФ" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff6dc;strokeColor=#d6a239;fontColor=#172c4c;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=14;spacingRight=55;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="575" width="880" height="95" />
        </mxCell>
        <mxCell id="monitor-icon" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="monitor">
          <mxGeometry as="geometry" x="835" y="12" width="30" height="30" />
        </mxCell>
        <mxCell id="checks1" value="&lt;b&gt;H1–H5 • исключение нездоровых обработчиков&lt;/b&gt;&lt;br&gt;H1: каждые 5 с, timeout 2 с, 3 неуспеха → исключить origin (~15–21 с).&lt;br&gt;/ready-origin = маршрутизация + синтетический доступ к БД + active-site lease.&lt;br&gt;В B HTTP 503 до promote, fencing и smoke test; отказ A не разрешает запись в B.&lt;br&gt;H2: LB проверяет Ingress каждые 5 с, timeout 2 с, fall 3; узел удаляется из пула.&lt;br&gt;H3: kubelet /readyz каждые 5 с, timeout 2 с, fall 3 → pod убирается из Service.&lt;br&gt;H4: /livez каждые 10 с, fall 3; /startupz с бюджетом 120 с до запуска остальных probes.&lt;br&gt;H5: HAProxy проверяет ВСЕ PG VM /primary каждые 2 с, timeout 1 с, fall 3, rise 2.&lt;br&gt;После смены primary закрываются старые соединения; PgBouncer переподключается.&lt;br&gt;H3 проверяет локальную готовность; общие зависимости проверяются в H1 и H10." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=#5282ff;fontColor=#172c4c;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=14;spacingRight=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="725" width="890" height="285" />
        </mxCell>
        <mxCell id="checks2" value="&lt;b&gt;H6–H10 • сохранность данных и клиентский SLI&lt;/b&gt;&lt;br&gt;H6: раз в 10 с — heartbeat LSN, durable flush B, backlog и replay lag (см. стр. 3).&lt;br&gt;H7: Patroni lease: ttl 30 с, loop_wait 10 с, retry_timeout 10 с; quorum 2/3.&lt;br&gt;Watchdog required; при потере lease старый primary останавливается.&lt;br&gt;H8: каждую минуту — archive success, gap WAL, возраст backup, свободное место.&lt;br&gt;Ежемесячно — восстановить независимую копию, проверить данные и время PITR.&lt;br&gt;H9: CDN → оба origins: HEAD контрольного web-объекта каждые 10 с, fall 3.&lt;br&gt;H10: снаружи — DNS/TLS, загрузка страницы, поиск и тестовая заявка каждые 30 с.&lt;br&gt;Оповещение дежурному ≤ 2 мин, подтверждение ≤ 3 мин; эскалация при молчании.&lt;br&gt;Протоколы проверок — проектные настройки; валидировать на выбранном LB/CDN." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=#5282ff;fontColor=#172c4c;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=14;spacingRight=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="970" y="725" width="900" height="285" />
        </mxCell>
        <mxCell id="geo" value="&lt;b&gt;География: одинаковый целевой уровень обслуживания&lt;/b&gt;&lt;br&gt;Браузер получает интерфейс с ближайшего здорового CDN PoP, origin выбирается по H9.&lt;br&gt;Публичный каталог кешируется, TTL ≤ 60 с; цена перепроверяется при оформлении.&lt;br&gt;Личные данные, история и запись идут в активную площадку через ближайший edge.&lt;br&gt;Предлагаемые критерии: p95 LCP ≤ 2,5 с и p95 чтения API ≤ 1 с в каждой тестовой точке.&lt;br&gt;При одинаковой сети/устройстве разброс p95 LCP между точками ≤ 300 мс.&lt;br&gt;Москва, Екатеринбург, Новосибирск, Владивосток: warm/cold cache и мобильная сеть.&lt;br&gt;Цифры требуют согласования и измерений; это не результаты выполненного теста.&lt;br&gt;Строго равная задержка для всех соединений физически недостижима.&lt;br&gt;Если динамический API не проходит бюджет, нужна отдельная проработка региональных&lt;br&gt;read-моделей; выдавать устаревшие персональные данные с DR-реплики нельзя." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff6dc;strokeColor=#d6a239;fontColor=#172c4c;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=14;spacingRight=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="1055" width="890" height="305" />
        </mxCell>
        <mxCell id="scope" value="&lt;b&gt;Данные • изоляция партнёров • внешние зависимости&lt;/b&gt;&lt;br&gt;Шардирование не применяется: 50 GB не оправдывают распределённые транзакции.&lt;br&gt;Сохраняются отдельные схемы и DB-роли сервисов; индексы, pooling, кеш каталога.&lt;br&gt;Реплики — для HA; по умолчанию бизнес-чтения идут в primary (read-after-write).&lt;br&gt;Edge ограничивает суммарный трафик партнёра по его ID: 20 RPS из исходного SLA.&lt;br&gt;Счётчик общий для edge-узлов; раздельные пулы/квоты B2C и B2B; превышение → 429.&lt;br&gt;Task6 отдельно требует учебный Nginx-лимит 10 запросов/мин — это другой контракт.&lt;br&gt;Сетевые политики: извне доступны только edge/LB; DB и служебные API приватны.&lt;br&gt;Сервисы сохраняют REST-взаимодействия; исходящие вызовы — через HA egress.&lt;br&gt;Cron/settlement: блокировка задания в БД + idempotency; активная площадка одна.&lt;br&gt;Event Streaming, ОСАГО и GraphQL в этом задании не внедряются." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef8f0;strokeColor=#64a978;fontColor=#172c4c;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=14;spacingRight=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="970" y="1055" width="900" height="305" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-3" name="03 — Failover, RTO, RPO и приёмка">
    <mxGraphModel dx="1900" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Переключение и восстановление&lt;/b&gt;&lt;br&gt;RTO считается с момента отказа до успешной клиентской операции; RPO — по последним подтверждённым данным" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e3ebff;strokeColor=#5282ff;fontColor=#172c4c;fontFamily=Arial;fontSize=22;align=left;verticalAlign=top;spacing=14;spacingRight=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1840" height="80" />
        </mxCell>
        <mxCell id="local" value="&lt;b&gt;Обычный отказ: pod / worker / одна AZ&lt;/b&gt;&lt;br&gt;Active-active внутри A: LB удаляет неисправные endpoints; оставшиеся AZ несут пик.&lt;br&gt;PostgreSQL: synchronous_mode=on, synchronous_mode_strict=true, synchronous_node_count=1.&lt;br&gt;synchronous_commit=on; sync standby в другой AZ; отдельная третья streaming replica.&lt;br&gt;Patroni повышает допустимую sync-копию, HAProxy находит новый primary.&lt;br&gt;DCS quorum 2/3 + watchdog защищают от split-brain; потеря quorum останавливает запись.&lt;br&gt;Цель RTO ≤ 2 мин, RPO = 0 для успешно подтверждённых commit при одиночном отказе.&lt;br&gt;Прерванная операция может иметь неизвестный исход: повтор только с Idempotency-Key." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef8f0;strokeColor=#64a978;fontColor=#172c4c;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=14;spacingRight=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="135" width="890" height="240" />
        </mxCell>
        <mxCell id="rpo" value="&lt;b&gt;Межрегиональный RPO ≤ 15 мин: не только async replication&lt;/b&gt;&lt;br&gt;Primary A пишет heartbeat с timestamp/LSN каждые 10 с; B сообщает durable flush LSN.&lt;br&gt;Сопоставление LSN и времени даёт возраст последней сохранённой точки, включая простой.&lt;br&gt;Lag &amp;gt; 5 мин: page; &amp;gt; 10 мин: закрыть все write-path, Cron и незавершённые транзакции.&lt;br&gt;Разрешение записи выдаётся на ≤ 60 с; без обновления закрывается доступ через DB proxy.&lt;br&gt;Контроль и остановка ≤ 60 с, погрешность часов ≤ 10 с: окно потери &amp;lt; 12 мин.&lt;br&gt;Fail-closed действует на ВСЕХ писателей, не только на ingress; обходной доступ запрещён.&lt;br&gt;Это отдельный обязательный механизм; один alert или лимит lag в байтах RPO не обеспечит." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff6dc;strokeColor=#d6a239;fontColor=#172c4c;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=14;spacingRight=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="970" y="135" width="900" height="240" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;1. Обнаружить&lt;/b&gt;&lt;br&gt;H1 + H10 → инцидент&lt;br&gt;Дежурный 24/7&lt;br&gt;Бюджет: 2 мин" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f8ff;strokeColor=#5282ff;fontColor=#172c4c;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=14;spacingRight=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="435" width="320" height="140" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;2. Изолировать A&lt;/b&gt;&lt;br&gt;Отозвать write lease&lt;br&gt;Fence всех PG VM в A&lt;br&gt;Бюджет: 5 мин" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f8ff;strokeColor=#5282ff;fontColor=#172c4c;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=14;spacingRight=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="410" y="435" width="320" height="140" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;3. Повысить B&lt;/b&gt;&lt;br&gt;Проверить WAL / timeline&lt;br&gt;Replay → promote → sync&lt;br&gt;Бюджет: 5 мин" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f8ff;strokeColor=#5282ff;fontColor=#172c4c;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=14;spacingRight=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="790" y="435" width="320" height="140" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;4. Проверить B&lt;/b&gt;&lt;br&gt;Версии, секреты, workers&lt;br&gt;Smoke: чтение + запись&lt;br&gt;Бюджет: 5 мин" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f8ff;strokeColor=#5282ff;fontColor=#172c4c;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=14;spacingRight=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1170" y="435" width="320" height="140" />
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;5. Открыть трафик&lt;/b&gt;&lt;br&gt;H1=200 → edge route B&lt;br&gt;Клиент повторяет запрос&lt;br&gt;Бюджет: 3 мин" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f8ff;strokeColor=#5282ff;fontColor=#172c4c;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=14;spacingRight=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1550" y="435" width="320" height="140" />
        </mxCell>
        <mxCell id="s0-next" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#385a8a;fontColor=#385a8a;fontSize=14;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="s1-next" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#385a8a;fontColor=#385a8a;fontSize=14;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="s2-next" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#385a8a;fontColor=#385a8a;fontSize=14;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="s3-next" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#385a8a;fontColor=#385a8a;fontSize=14;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="failover" value="&lt;b&gt;Клиент → edge → B • целевой RTO 20 мин, резерв 25 мин&lt;/b&gt;&lt;br&gt;Edge endpoint и DNS для клиента сохраняются: переключается origin с A на B.&lt;br&gt;На время перехода API отвечает 503 + Retry-After; статика остаётся в CDN.&lt;br&gt;B2B/браузер: backoff с jitter, общий timeout; повтор записи с тем же ключом идемпотентности.&lt;br&gt;В A отключаются все PG VM / маршруты записи; одного DNS-переключения недостаточно.&lt;br&gt;Если fencing не доказан, B не становится writable: предотвращается двойной primary.&lt;br&gt;Promotion только после проверки непрерывности WAL, flush watermark и допустимого RPO.&lt;br&gt;Удалить standby_cluster в DCS B; дождаться локальной sync-копии; открыть DB write lease.&lt;br&gt;Восстановленную A присоединить через pg_rewind/basebackup; failback вручную по регламенту.&lt;br&gt;После promote write guard следит за внешним WAL-архивом; далее — за репликацией B → A." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e3ebff;strokeColor=#5282ff;fontColor=#172c4c;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=14;spacingRight=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="635" width="890" height="270" />
        </mxCell>
        <mxCell id="restore" value="&lt;b&gt;Повреждение данных: pgBackRest + PITR в чистый кластер&lt;/b&gt;&lt;br&gt;Репликация переносит ошибочное удаление; нужен независимый неизменяемый backup.&lt;br&gt;Полный backup раз в неделю, differential ежедневно, WAL непрерывно; retention ≥ 35 дней.&lt;br&gt;archive_timeout=60 с задаёт частоту закрытия WAL, но не гарантирует срок доставки.&lt;br&gt;H8 контролирует доставку; при нарушении окна сохранности действует write guard.&lt;br&gt;План RTO: 5 мин определить точку + 15 восстановить + 10 replay + 10 проверить/переключить.&lt;br&gt;50 GB за 15 мин требуют ≥ 56 MB/s только на данные; ресурс резервируется и измеряется.&lt;br&gt;До запуска нужны тесты на реальном объёме WAL; 40 мин — бюджет, а не доказанный результат.&lt;br&gt;При позднем обнаружении логической ошибки нельзя обещать RPO 15 мин одним PITR." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff6dc;strokeColor=#d6a239;fontColor=#172c4c;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=14;spacingRight=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="970" y="635" width="900" height="270" />
        </mxCell>
        <mxCell id="sla" value="&lt;b&gt;99,9% • бюджет ошибок и зависимости&lt;/b&gt;&lt;br&gt;За 30 дней допускается 43 мин 12 с недоступности; за год — около 8 ч 46 мин.&lt;br&gt;Один инцидент на 45 мин уже превышает месячный бюджет: RTO — предел, не цель.&lt;br&gt;SLI: успешная загрузка и ключевые API в пределах latency budget; ошибки и таймауты считаются.&lt;br&gt;Контроль p95/p99, 5xx, очередей, OOM, DB IOPS, пулов, WAL, backup и оставшегося error budget.&lt;br&gt;Плановые обновления — поочерёдно, с rollback; круглосуточное дежурство и DR-учения.&lt;br&gt;Недоступность страховщика ограничивается timeout/circuit breaker и частичным результатом." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef8f0;strokeColor=#64a978;fontColor=#172c4c;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=14;spacingRight=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="960" width="890" height="225" />
        </mxCell>
        <mxCell id="assumptions" value="&lt;b&gt;Условия применимости проекта&lt;/b&gt;&lt;br&gt;B — реально отдельный регион РФ / провайдер с 3 локальными доменами отказа и HA сетью.&lt;br&gt;Не утверждается наличие регионов YC в Сибири или на Дальнем Востоке.&lt;br&gt;Edge/DNS и backup не зависят от control-plane A; управление B и ключи доступны при потере A.&lt;br&gt;Нужны зарезервированные мощности, два WAN-канала и fencing с независимым управлением.&lt;br&gt;SLO региональной скорости и бюджет PITR подтверждаются до рекламной кампании.&lt;br&gt;RTO/RPO при одновременной потере обеих площадок вне модели одиночного отказа." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f3efff;strokeColor=#9b85c6;fontColor=#172c4c;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=14;spacingRight=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="970" y="960" width="900" height="225" />
        </mxCell>
        <mxCell id="accept" value="&lt;b&gt;Приёмка перед промышленным запуском&lt;/b&gt;&lt;br&gt;1. Отключить pod, worker и целую AZ под проектным пиком; измерить клиентский простой ≤ 2 мин, проверить отсутствие потери подтверждённых заявок.&lt;br&gt;2. Разорвать WAN и канал мониторинга; убедиться, что через ≤ 11 мин блокируются ВСЕ новые записи, включая фоновые задачи и существующие DB-соединения.&lt;br&gt;3. Изолировать A; подтвердить fencing, повысить B, восстановить клиентский путь ≤ 20 мин и сверить RPO по журналу подтверждений / Idempotency-Key.&lt;br&gt;4. Восстановить 50 GB и накопленный WAL из независимого backup; измерить RTO ≤ 40 мин; проверить данные, права, секреты и отсутствие дубликатов.&lt;br&gt;5. Прогнать LCP/API из регионов, скачок нагрузки и шумного B2B-партнёра; проверить 429, ресурсный запас, алерты и обновление без простоя.&lt;br&gt;Ни один из этих тестов не выдаётся за выполненный: в Task1 создан архитектурный проект, без развёртывания инфраструктуры." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=#5282ff;fontColor=#172c4c;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=14;spacingRight=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="1240" width="1840" height="190" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>